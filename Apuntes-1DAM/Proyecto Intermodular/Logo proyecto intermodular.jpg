<svg xmlns="http://www.w3.org/2000/svg" width="1100" height="300" viewBox="0 0 1100 300" role="img" aria-labelledby="title desc">
  <title id="title">MyHealthLog</title>
  <desc id="desc">Logo de MyHealthLog: una línea de evolución de salud dentro de un icono verde azulado, con un punto coral.</desc>
  <rect width="1100" height="300" fill="#F7FAF8"/>
  <g transform="translate(48 38)">
    <rect width="224" height="224" rx="58" fill="#123E45"/>
    <path d="M39 133h34l17-39 25 78 24-57 17 18h30" fill="none" stroke="#A9E7D2" stroke-width="13" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="186" cy="133" r="12" fill="#FF8B72"/>
    <path d="M42 183h140" stroke="#FFFFFF" stroke-opacity=".18" stroke-width="3" stroke-linecap="round"/>
  </g>
  <text x="322" y="155" fill="#123E45" font-family="Inter, Segoe UI, Arial, sans-serif" font-size="78" font-weight="750" letter-spacing="1">MyHealthLog</text>
  <text x="328" y="208" fill="#537276" font-family="Inter, Segoe UI, Arial, sans-serif" font-size="25" font-weight="500" letter-spacing="2.2">YOUR HEALTH, OVER TIME</text>
</svg>
